@using Microsoft.JSInterop
@using SharedLib
@implements IDisposable
@inject IJSRuntime JSRuntime

<h3>MapBasicsComponent</h3>

<body>
    <div id="map" style="width: 100%; height: 400px"></div>
</body>

@code {
    DotNetObjectReference<MapBasicsComponent>? objRef;
    [JSInvokable]
    public static async Task<ResponseBaseModel> InitPlacemarkYaMapsAsync()
    {
        return ResponseBaseModel.CreateInfo("initPlacemark");
    }
     
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("startYaMap", objRef);
        }
    }

    public void Dispose() => objRef?.Dispose();
}